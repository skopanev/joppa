# Copy to .env and edit locally. Never commit .env or private configuration files.
# Load explicitly: set -a; . ./.env; set +a
# Then run: server/deploy.sh

JOPPA_DEPLOY_HOST=root@SERVER_IP
JOPPA_DOMAIN=app.example.com
JOPPA_CONFIG_DIR=/private/joppa-config

# Optional SSH config; its host alias may be used as JOPPA_DEPLOY_HOST.
JOPPA_SSH_CONFIG=

# Optional initial database dump. ONLY for a fresh server; clear after first deploy.
JOPPA_INITIAL_DUMP=

# Private files in JOPPA_CONFIG_DIR:
# Required: tokens.json, login-users.json
# Optional: google-client.json, backup.env, storage.env
# Spaces templates: server/backup.env.example and server/storage.env.example
# Google JSON format: README.md. Do not put real credentials in this example.
