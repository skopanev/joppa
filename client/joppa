#!/usr/bin/env python3
"""Small Bash-friendly client for Joppa over the public MCP endpoint."""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request


class JoppaError(Exception):
    pass


def mcp(args, name, arguments):
    token = os.getenv("JOPPA_TOKEN")
    token_file = args.token_file or os.getenv("JOPPA_TOKEN_FILE")
    if not token and token_file:
        try:
            with open(token_file, encoding="utf-8") as source:
                token = source.read().strip()
        except OSError as error:
            raise JoppaError(f"cannot read token file: {error.strerror}") from error
    if not token:
        raise JoppaError("set JOPPA_TOKEN or JOPPA_TOKEN_FILE")
    url = args.url or os.getenv("JOPPA_MCP_URL")
    if not url or not url.endswith("/mcp"):
        raise JoppaError("set JOPPA_MCP_URL to the HTTPS /mcp endpoint")
    payload = {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": name, "arguments": arguments}}
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            reply = json.load(response)
    except urllib.error.HTTPError as error:
        raise JoppaError(f"MCP HTTP {error.code}") from error
    except urllib.error.URLError as error:
        raise JoppaError(f"MCP connection failed: {error.reason}") from error
    result = reply.get("result", {})
    if result.get("isError"):
        message = " ".join(part.get("text", "") for part in result.get("content", []))
        raise JoppaError(message or "Joppa rejected the request")
    if "error" in reply:
        raise JoppaError(reply["error"].get("message", "MCP error"))
    try:
        return json.loads(result["content"][0]["text"])
    except (KeyError, IndexError, ValueError) as error:
        raise JoppaError("invalid MCP response") from error


def workspace(args):
    value = args.workspace or os.getenv("JOPPA_WORKSPACE")
    if not value:
        raise JoppaError("set --workspace or JOPPA_WORKSPACE")
    return value


def main():
    parser = argparse.ArgumentParser(prog="joppa", description="Joppa MCP client")
    group = parser.add_subparsers(dest="resource", required=True)

    find = group.add_parser("search", help="hybrid search of objects through authenticated MCP")
    find.add_argument("query")
    find.add_argument("--workspace")
    find.add_argument("--url", help="MCP endpoint; defaults to JOPPA_MCP_URL")
    find.add_argument("--token-file", help="private bearer token file; defaults to JOPPA_TOKEN_FILE")
    find.add_argument("--kind")
    find.add_argument("--limit", type=int, default=10)
    find.add_argument("--all-versions", action="store_true", help="also read past revisions and archived objects")
    find.add_argument("--all-workspaces", action="store_true", help="read each workspace that you can read")

    raw = group.add_parser("command", help="send a JSON operation through authenticated MCP")
    raw.add_argument("workspace")
    raw.add_argument("request_id")
    raw.add_argument("--url", help="MCP endpoint; defaults to JOPPA_MCP_URL")
    raw.add_argument("--token-file", help="private bearer token file; defaults to JOPPA_TOKEN_FILE")

    args = parser.parse_args()
    space = workspace(args)
    if args.resource == "search":
        query = {"workspace": space, "query": args.query, "limit": args.limit,
                 "all_versions": args.all_versions, "all_workspaces": args.all_workspaces}
        if args.kind:
            query["kind"] = args.kind
        print(json.dumps(mcp(args, "joppa_search", query), ensure_ascii=False, separators=(",", ":")))
        return
    if args.resource == "command":
        try:
            value = json.load(sys.stdin)
        except (ValueError, OSError) as error:
            raise JoppaError("read one JSON operation from stdin") from error
        if not isinstance(value, dict):
            raise JoppaError("operation must be a JSON object")
        output = mcp(args, "joppa_command", {"workspace":space,"request_id":args.request_id,"command":value})
        print(json.dumps(output, ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except JoppaError as error:
        print(f"joppa: {error}", file=sys.stderr)
        sys.exit(1)
