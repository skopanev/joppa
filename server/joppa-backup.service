[Unit]
Description=Joppa daily PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
EnvironmentFile=/etc/joppa/backup.env
User=postgres
Group=postgres
ExecStart=/opt/joppa/server/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/joppa
