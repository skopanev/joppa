# Install as /etc/joppa/runtime.env, root:joppa 0640. Never commit real credentials.
JOPPA_DATABASE_URL=postgresql://joppa_app:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/joppa
JOPPA_TOKENS_FILE=/etc/joppa/tokens.json
JOPPA_LOGIN_USERS_FILE=/etc/joppa/login-users.json
# Enable only after configuring Joppa's own Google client and exact HTTPS callback:
# JOPPA_GOOGLE_CLIENT_FILE=/etc/joppa/google-client.json
# JOPPA_ACCESS_RULES_FILE=/etc/joppa/access-rules.json
