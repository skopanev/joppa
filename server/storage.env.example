# Install as /etc/joppa/storage.env, root:root 0600.
# The server keeps attachment bytes here and does not start without these variables.
# This key is scoped to application files, never database backups.
SPACES_BUCKET=YOUR_APPLICATION_BUCKET
SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
SPACES_REGION=ams3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
